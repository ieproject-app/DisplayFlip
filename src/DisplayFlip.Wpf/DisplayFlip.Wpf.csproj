<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>DisplayFlip.UI</RootNamespace>
    <AssemblyName>DisplayFlip.Wpf</AssemblyName>
    <ApplicationIcon>DisplayFlip.ico</ApplicationIcon>
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DisplayFlip.Core\DisplayFlip.Core.csproj" />
    <ProjectReference Include="..\DisplayFlip.Windows\DisplayFlip.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="DisplayFlip.ico" />
  </ItemGroup>

</Project>
