<Page
    x:Class="DisplayFlip.UI.Views.Pages.ShortcutsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="clr-namespace:DisplayFlip.UI.Services"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{Binding [Shortcuts.PageTitle], Source={x:Static services:Loc.Instance}}"
    d:DesignHeight="950"
    d:DesignWidth="800"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <StackPanel Margin="32,24,32,32">
        <!-- Judul & Deskripsi Halaman -->
        <ui:TextBlock
            FontTypography="Title"
            Text="{Binding [Shortcuts.PageTitle], Source={x:Static services:Loc.Instance}}" />
        <ui:TextBlock
            Margin="0,4,0,16"
            Appearance="Secondary"
            FontTypography="Body"
            Text="{Binding [Shortcuts.PageSubtitle], Source={x:Static services:Loc.Instance}}" />

        <!-- Status InfoBar Notifikasi -->
        <ui:InfoBar
            x:Name="PageInfoBar"
            Margin="0,0,0,16"
            IsOpen="False"
            IsClosable="True" />

        <!-- BAGIAN 1: Aksi Cepat Global -->
        <ui:TextBlock
            Margin="0,4,0,12"
            FontTypography="Subtitle"
            Text="{Binding [Shortcuts.Section.Global], Source={x:Static services:Loc.Instance}}" />

        <!-- 1. Balik / Tukar Posisi Layar -->
        <ui:CardControl Margin="0,0,0,12">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock FontTypography="BodyStrong" Text="{Binding [Shortcuts.Global.Mirror.Title], Source={x:Static services:Loc.Instance}}" />
                    <ui:TextBlock Appearance="Secondary" Text="{Binding [Shortcuts.Global.Mirror.Desc], Source={x:Static services:Loc.Instance}}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="ArrowSwap24" />
            </ui:CardControl.Icon>
            <ui:Button
                x:Name="BtnShortcutMirror"
                Appearance="Secondary"
                Padding="12,6"
                Click="OnGlobalShortcutClicked"
                Tag="mirror" />
        </ui:CardControl>

        <!-- 2. Siklus Layar Utama -->
        <ui:CardControl Margin="0,0,0,12">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock FontTypography="BodyStrong" Text="{Binding [Shortcuts.Global.Primary.Title], Source={x:Static services:Loc.Instance}}" />
                    <ui:TextBlock Appearance="Secondary" Text="{Binding [Shortcuts.Global.Primary.Desc], Source={x:Static services:Loc.Instance}}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="ArrowRepeatAll24" />
            </ui:CardControl.Icon>
            <ui:Button
                x:Name="BtnShortcutPrimary"
                Appearance="Secondary"
                Padding="12,6"
                Click="OnGlobalShortcutClicked"
                Tag="primary" />
        </ui:CardControl>

        <!-- 3. Identifikasi Layar -->
        <ui:CardControl Margin="0,0,0,12">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock FontTypography="BodyStrong" Text="{Binding [Shortcuts.Global.Identify.Title], Source={x:Static services:Loc.Instance}}" />
                    <ui:TextBlock Appearance="Secondary" Text="{Binding [Shortcuts.Global.Identify.Desc], Source={x:Static services:Loc.Instance}}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="Eye24" />
            </ui:CardControl.Icon>
            <ui:Button
                x:Name="BtnShortcutIdentify"
                Appearance="Secondary"
                Padding="12,6"
                Click="OnGlobalShortcutClicked"
                Tag="identify" />
        </ui:CardControl>

        <!-- 4. Hanya Layar 1 -->
        <ui:CardControl Margin="0,0,0,12">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock FontTypography="BodyStrong" Text="{Binding [Shortcuts.Global.Solo1.Title], Source={x:Static services:Loc.Instance}}" />
                    <ui:TextBlock Appearance="Secondary" Text="{Binding [Shortcuts.Global.Solo1.Desc], Source={x:Static services:Loc.Instance}}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="Desktop24" />
            </ui:CardControl.Icon>
            <ui:Button
                x:Name="BtnShortcutSolo1"
                Appearance="Secondary"
                Padding="12,6"
                Click="OnGlobalShortcutClicked"
                Tag="solo1" />
        </ui:CardControl>

        <!-- 5. Hanya Layar 2 -->
        <ui:CardControl Margin="0,0,0,12">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock FontTypography="BodyStrong" Text="{Binding [Shortcuts.Global.Solo2.Title], Source={x:Static services:Loc.Instance}}" />
                    <ui:TextBlock Appearance="Secondary" Text="{Binding [Shortcuts.Global.Solo2.Desc], Source={x:Static services:Loc.Instance}}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="Desktop24" />
            </ui:CardControl.Icon>
            <ui:Button
                x:Name="BtnShortcutSolo2"
                Appearance="Secondary"
                Padding="12,6"
                Click="OnGlobalShortcutClicked"
                Tag="solo2" />
        </ui:CardControl>

        <!-- 6. Bentangkan Layar -->
        <ui:CardControl Margin="0,0,0,12">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock FontTypography="BodyStrong" Text="{Binding [Shortcuts.Global.Extend.Title], Source={x:Static services:Loc.Instance}}" />
                    <ui:TextBlock Appearance="Secondary" Text="{Binding [Shortcuts.Global.Extend.Desc], Source={x:Static services:Loc.Instance}}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="FullScreenMaximize24" />
            </ui:CardControl.Icon>
            <ui:Button
                x:Name="BtnShortcutExtend"
                Appearance="Secondary"
                Padding="12,6"
                Click="OnGlobalShortcutClicked"
                Tag="extend" />
        </ui:CardControl>

        <!-- BAGIAN 2: Pintasan Profil Tersimpan -->
        <ui:TextBlock
            Margin="0,16,0,4"
            FontTypography="Subtitle"
            Text="{Binding [Shortcuts.Section.Profiles], Source={x:Static services:Loc.Instance}}" />
        <ui:TextBlock
            Margin="0,0,0,12"
            Appearance="Secondary"
            FontTypography="Body"
            Text="{Binding [Shortcuts.Section.ProfilesSubtitle], Source={x:Static services:Loc.Instance}}" />

        <!-- Daftar Profil Dinamis -->
        <StackPanel x:Name="ProfilesShortcutsPanel" />

        <!-- State Kosong jika belum ada profil -->
        <ui:CardControl
            x:Name="EmptyProfilesCard"
            Margin="0,0,0,12"
            Visibility="Collapsed">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock FontTypography="BodyStrong" Text="{Binding [Shortcuts.Empty.Title], Source={x:Static services:Loc.Instance}}" />
                    <ui:TextBlock Appearance="Secondary" Text="{Binding [Shortcuts.Empty.Desc], Source={x:Static services:Loc.Instance}}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="Info24" />
            </ui:CardControl.Icon>
        </ui:CardControl>
    </StackPanel>
</Page>
