<Page
    x:Class="DisplayFlip.UI.Views.Pages.GeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="clr-namespace:DisplayFlip.UI.Services"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{Binding [General.PageTitle], Source={x:Static services:Loc.Instance}}"
    d:DesignHeight="950"
    d:DesignWidth="800"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <StackPanel Margin="32,24,32,32">
        <!-- Judul & Deskripsi Halaman -->
        <ui:TextBlock
            FontTypography="Title"
            Text="{Binding [General.PageTitle], Source={x:Static services:Loc.Instance}}" />
        <ui:TextBlock
            Margin="0,4,0,16"
            Appearance="Secondary"
            FontTypography="Body"
            Text="{Binding [General.PageSubtitle], Source={x:Static services:Loc.Instance}}"
            TextWrapping="Wrap" />

        <!-- Status InfoBar Notifikasi -->
        <ui:InfoBar
            x:Name="PageInfoBar"
            Margin="0,0,0,16"
            IsOpen="False"
            IsClosable="True" />

        <!-- BAGIAN 1: Perilaku Aplikasi -->
        <ui:TextBlock
            Margin="0,4,0,12"
            FontTypography="Subtitle"
            Text="{Binding [General.Section.SystemBehavior], Source={x:Static services:Loc.Instance}}" />

        <!-- Card: Startup Otomatis Windows -->
        <ui:CardControl Margin="0,0,0,12">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock FontTypography="BodyStrong" Text="{Binding [General.Startup.Title], Source={x:Static services:Loc.Instance}}" />
                    <ui:TextBlock
                        Appearance="Secondary"
                        Text="{Binding [General.Startup.Desc], Source={x:Static services:Loc.Instance}}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="Power24" />
            </ui:CardControl.Icon>
            <ui:ToggleSwitch
                x:Name="ToggleStartup"
                Click="OnToggleStartupClick" />
        </ui:CardControl>

        <!-- Card: Auto-Apply Drag Tata Letak -->
        <ui:CardControl Margin="0,0,0,16">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock FontTypography="BodyStrong" Text="{Binding [General.AutoApply.Title], Source={x:Static services:Loc.Instance}}" />
                    <ui:TextBlock
                        Appearance="Secondary"
                        Text="{Binding [General.AutoApply.Desc], Source={x:Static services:Loc.Instance}}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="Flash24" />
            </ui:CardControl.Icon>
            <ui:ToggleSwitch
                x:Name="ToggleAutoApply"
                Click="OnToggleAutoApplyClick" />
        </ui:CardControl>

        <!-- BAGIAN 1B: Bahasa Antarmuka -->
        <ui:TextBlock
            Margin="0,8,0,12"
            FontTypography="Subtitle"
            Text="{Binding [General.Section.Language], Source={x:Static services:Loc.Instance}}" />

        <ui:CardControl Margin="0,0,0,16">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock FontTypography="BodyStrong" Text="{Binding [General.Language.CardTitle], Source={x:Static services:Loc.Instance}}" />
                    <ui:TextBlock
                        Appearance="Secondary"
                        Text="{Binding [General.Language.CardDesc], Source={x:Static services:Loc.Instance}}"
                        TextWrapping="Wrap" />
                    <ui:TextBlock
                        x:Name="TxtEffectiveLanguage"
                        Margin="0,4,0,0"
                        Appearance="Tertiary"
                        FontTypography="Caption" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="Globe24" />
            </ui:CardControl.Icon>
            <ComboBox
                x:Name="LanguageComboBox"
                MinWidth="220"
                SelectionChanged="OnLanguageSelectionChanged">
                <ComboBoxItem Content="{Binding [General.Language.FollowWindows], Source={x:Static services:Loc.Instance}}" Tag="auto" />
                <ComboBoxItem Content="{Binding [General.Language.Indonesian], Source={x:Static services:Loc.Instance}}" Tag="id" />
                <ComboBoxItem Content="{Binding [General.Language.English], Source={x:Static services:Loc.Instance}}" Tag="en" />
            </ComboBox>
        </ui:CardControl>

        <!-- BAGIAN 2: Personalisasi Tema Aplikasi -->
        <ui:TextBlock
            Margin="0,8,0,12"
            FontTypography="Subtitle"
            Text="{Binding [General.Section.Theme], Source={x:Static services:Loc.Instance}}" />

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Card Tema: Ikuti Sistem -->
            <ui:Card
                x:Name="ThemeSystemCard"
                Grid.Column="0"
                Padding="16"
                Cursor="Hand"
                Focusable="True"
                MouseLeftButtonUp="OnThemeSystemCardClick"
                KeyDown="OnThemeSystemCardKeyDown">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <ui:SymbolIcon Symbol="Desktop24" HorizontalAlignment="Left" FontSize="24" />
                        <RadioButton
                            x:Name="RadioThemeSystem"
                            HorizontalAlignment="Right"
                            GroupName="AppThemeGroup"
                            IsHitTestVisible="False"
                            Focusable="False" />
                    </Grid>
                    <ui:TextBlock FontTypography="BodyStrong" Text="{Binding [General.Theme.System.Title], Source={x:Static services:Loc.Instance}}" Margin="0,0,0,4" />
                    <ui:TextBlock
                        Appearance="Secondary"
                        FontTypography="Caption"
                        Text="{Binding [General.Theme.System.Subtitle], Source={x:Static services:Loc.Instance}}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </ui:Card>

            <!-- Card Tema: Mode Terang -->
            <ui:Card
                x:Name="ThemeLightCard"
                Grid.Column="2"
                Padding="16"
                Cursor="Hand"
                Focusable="True"
                MouseLeftButtonUp="OnThemeLightCardClick"
                KeyDown="OnThemeLightCardKeyDown">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <ui:SymbolIcon Symbol="WeatherSunny24" HorizontalAlignment="Left" FontSize="24" />
                        <RadioButton
                            x:Name="RadioThemeLight"
                            HorizontalAlignment="Right"
                            GroupName="AppThemeGroup"
                            IsHitTestVisible="False"
                            Focusable="False" />
                    </Grid>
                    <ui:TextBlock FontTypography="BodyStrong" Text="{Binding [General.Theme.Light.Title], Source={x:Static services:Loc.Instance}}" Margin="0,0,0,4" />
                    <ui:TextBlock
                        Appearance="Secondary"
                        FontTypography="Caption"
                        Text="{Binding [General.Theme.Light.Subtitle], Source={x:Static services:Loc.Instance}}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </ui:Card>

            <!-- Card Tema: Mode Gelap -->
            <ui:Card
                x:Name="ThemeDarkCard"
                Grid.Column="4"
                Padding="16"
                Cursor="Hand"
                Focusable="True"
                MouseLeftButtonUp="OnThemeDarkCardClick"
                KeyDown="OnThemeDarkCardKeyDown">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <ui:SymbolIcon Symbol="WeatherMoon24" HorizontalAlignment="Left" FontSize="24" />
                        <RadioButton
                            x:Name="RadioThemeDark"
                            HorizontalAlignment="Right"
                            GroupName="AppThemeGroup"
                            IsHitTestVisible="False"
                            Focusable="False" />
                    </Grid>
                    <ui:TextBlock FontTypography="BodyStrong" Text="{Binding [General.Theme.Dark.Title], Source={x:Static services:Loc.Instance}}" Margin="0,0,0,4" />
                    <ui:TextBlock
                        Appearance="Secondary"
                        FontTypography="Caption"
                        Text="{Binding [General.Theme.Dark.Subtitle], Source={x:Static services:Loc.Instance}}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </ui:Card>
        </Grid>

        <!-- BAGIAN 3: Gaya Ikon Modern (Tray & App) -->
        <ui:TextBlock
            Margin="0,8,0,12"
            FontTypography="Subtitle"
            Text="{Binding [General.Section.Icon], Source={x:Static services:Loc.Instance}}" />

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Card Ikon: Fluent Glass Dual -->
            <ui:Card
                x:Name="IconCardFluent"
                Grid.Column="0"
                Padding="16"
                Cursor="Hand"
                Focusable="True"
                MouseLeftButtonUp="OnIconCardFluentClick"
                KeyDown="OnIconCardFluentKeyDown">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Image
                            x:Name="IconPreviewFluent"
                            Width="44"
                            Height="44"
                            HorizontalAlignment="Left"
                            RenderOptions.BitmapScalingMode="HighQuality"
                            UseLayoutRounding="True"
                            SnapsToDevicePixels="True" />
                        <RadioButton
                            x:Name="RadioIconFluent"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            GroupName="IconStyleGroup"
                            IsHitTestVisible="False"
                            Focusable="False" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <ui:TextBlock FontTypography="BodyStrong" Text="{Binding [General.Icon.Fluent.Title], Source={x:Static services:Loc.Instance}}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <ui:Badge
                            x:Name="BadgeIconFluent"
                            Appearance="Success"
                            Content="{Binding [General.Badge.Active], Source={x:Static services:Loc.Instance}}"
                            VerticalAlignment="Center" />
                    </StackPanel>
                    <ui:TextBlock
                        Appearance="Secondary"
                        FontTypography="Caption"
                        Text="{Binding [General.Icon.Fluent.Subtitle], Source={x:Static services:Loc.Instance}}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </ui:Card>

            <!-- Card Ikon: Windows 11 Accent -->
            <ui:Card
                x:Name="IconCardAccent"
                Grid.Column="2"
                Padding="16"
                Cursor="Hand"
                Focusable="True"
                MouseLeftButtonUp="OnIconCardAccentClick"
                KeyDown="OnIconCardAccentKeyDown">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Image
                            x:Name="IconPreviewAccent"
                            Width="44"
                            Height="44"
                            HorizontalAlignment="Left"
                            RenderOptions.BitmapScalingMode="HighQuality"
                            UseLayoutRounding="True"
                            SnapsToDevicePixels="True" />
                        <RadioButton
                            x:Name="RadioIconAccent"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            GroupName="IconStyleGroup"
                            IsHitTestVisible="False"
                            Focusable="False" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <ui:TextBlock FontTypography="BodyStrong" Text="{Binding [General.Icon.Accent.Title], Source={x:Static services:Loc.Instance}}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <ui:Badge
                            x:Name="BadgeIconAccent"
                            Appearance="Success"
                            Content="{Binding [General.Badge.Active], Source={x:Static services:Loc.Instance}}"
                            VerticalAlignment="Center"
                            Visibility="Collapsed" />
                    </StackPanel>
                    <ui:TextBlock
                        Appearance="Secondary"
                        FontTypography="Caption"
                        Text="{Binding [General.Icon.Accent.Subtitle], Source={x:Static services:Loc.Instance}}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </ui:Card>

            <!-- Card Ikon: Minimalist Precision -->
            <ui:Card
                x:Name="IconCardMinimal"
                Grid.Column="4"
                Padding="16"
                Cursor="Hand"
                Focusable="True"
                MouseLeftButtonUp="OnIconCardMinimalClick"
                KeyDown="OnIconCardMinimalKeyDown">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Image
                            x:Name="IconPreviewMinimal"
                            Width="44"
                            Height="44"
                            HorizontalAlignment="Left"
                            RenderOptions.BitmapScalingMode="HighQuality"
                            UseLayoutRounding="True"
                            SnapsToDevicePixels="True" />
                        <RadioButton
                            x:Name="RadioIconMinimal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            GroupName="IconStyleGroup"
                            IsHitTestVisible="False"
                            Focusable="False" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <ui:TextBlock FontTypography="BodyStrong" Text="{Binding [General.Icon.Minimal.Title], Source={x:Static services:Loc.Instance}}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <ui:Badge
                            x:Name="BadgeIconMinimal"
                            Appearance="Success"
                            Content="{Binding [General.Badge.Active], Source={x:Static services:Loc.Instance}}"
                            VerticalAlignment="Center"
                            Visibility="Collapsed" />
                    </StackPanel>
                    <ui:TextBlock
                        Appearance="Secondary"
                        FontTypography="Caption"
                        Text="{Binding [General.Icon.Minimal.Subtitle], Source={x:Static services:Loc.Instance}}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </ui:Card>
        </Grid>

        <!-- BAGIAN 4: Direktori Penyimpanan Konfigurasi -->
        <ui:TextBlock
            Margin="0,8,0,12"
            FontTypography="Subtitle"
            Text="{Binding [General.Section.Storage], Source={x:Static services:Loc.Instance}}" />

        <ui:CardControl Margin="0,0,0,12">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock FontTypography="BodyStrong" Text="{Binding [General.Storage.Title], Source={x:Static services:Loc.Instance}}" />
                    <ui:TextBlock
                        x:Name="TxtStoragePath"
                        Appearance="Secondary"
                        Text="%LOCALAPPDATA%\DisplayFlip\profiles.json"
                        TextWrapping="Wrap" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="Folder24" />
            </ui:CardControl.Icon>
            <ui:Button
                x:Name="BtnOpenFolder"
                Content="{Binding [General.Storage.OpenFolder], Source={x:Static services:Loc.Instance}}"
                Icon="{ui:SymbolIcon Symbol=FolderOpen24}"
                Click="OnOpenFolderClick" />
        </ui:CardControl>
    </StackPanel>
</Page>
