<Page
    x:Class="DisplayFlip.UI.Views.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="clr-namespace:DisplayFlip.UI.Services"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{Binding [About.PageTitle], Source={x:Static services:Loc.Instance}}"
    d:DesignHeight="1100"
    d:DesignWidth="800"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <StackPanel Margin="32,24,32,32">
        <!-- Judul & Deskripsi Halaman -->
        <ui:TextBlock
            FontTypography="Title"
            Text="{Binding [About.PageTitle], Source={x:Static services:Loc.Instance}}" />
        <ui:TextBlock
            Margin="0,4,0,16"
            Appearance="Secondary"
            FontTypography="Body"
            Text="{Binding [About.PageSubtitle], Source={x:Static services:Loc.Instance}}"
            TextWrapping="Wrap" />

        <!-- Status InfoBar Notifikasi -->
        <ui:InfoBar
            x:Name="PageInfoBar"
            Margin="0,0,0,16"
            IsOpen="False"
            IsClosable="True" />

        <!-- BAGIAN 1: Identitas & Status Aplikasi -->
        <ui:Card Padding="24" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Image
                    x:Name="AppLogoImage"
                    Grid.Column="0"
                    Source="pack://application:,,,/DisplayFlip.ico"
                    Width="68"
                    Height="68"
                    Margin="0,0,24,0"
                    VerticalAlignment="Center"
                    RenderOptions.BitmapScalingMode="HighQuality"
                    UseLayoutRounding="True"
                    SnapsToDevicePixels="True" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <ui:TextBlock
                            FontTypography="TitleLarge"
                            FontWeight="SemiBold"
                            Text="DisplayFlip"
                            Margin="0,0,10,0" />
                        <ui:Badge
                            Appearance="Primary"
                            Content="{Binding [About.Hero.Badge], Source={x:Static services:Loc.Instance}}"
                            VerticalAlignment="Center" />
                    </StackPanel>

                    <ui:TextBlock
                        Margin="0,0,0,12"
                        Appearance="Secondary"
                        FontTypography="Body"
                        Text="{Binding [About.Hero.Description], Source={x:Static services:Loc.Instance}}"
                        TextWrapping="Wrap" />

                    <!-- Status Badges Runtime -->
                    <WrapPanel>
                        <ui:Badge
                            Appearance="Success"
                            Content=".NET 10 LTS"
                            Margin="0,0,8,6" />
                        <ui:Badge
                            Appearance="Success"
                            Content="WPF-UI 4.3.0"
                            Margin="0,0,8,6" />
                        <ui:Badge
                            Appearance="Info"
                            Content="Mica Backdrop Active"
                            Margin="0,0,8,6" />
                        <ui:Badge
                            Appearance="Info"
                            Content="Windows CCD API"
                            Margin="0,0,8,6" />
                        <ui:Badge
                            Appearance="Primary"
                            Content="64-bit Architecture"
                            Margin="0,0,8,6" />
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </ui:Card>

        <!-- BAGIAN 2: Dokumentasi & Referensi Perintah CLI -->
        <ui:TextBlock
            Margin="0,8,0,4"
            FontTypography="Subtitle"
            Text="{Binding [About.Section.Cli], Source={x:Static services:Loc.Instance}}" />
        <ui:TextBlock
            Margin="0,0,0,16"
            Appearance="Secondary"
            FontTypography="Body"
            Text="{Binding [About.Section.CliDesc], Source={x:Static services:Loc.Instance}}"
            TextWrapping="Wrap" />

        <!-- Wadah Kartu CLI Interaktif -->
        <StackPanel x:Name="CliCommandsPanel" Margin="0,0,0,16" />

        <!-- BAGIAN 3: Tautan Cepat & Sumber Daya -->
        <ui:TextBlock
            Margin="0,8,0,12"
            FontTypography="Subtitle"
            Text="{Binding [About.Section.Links], Source={x:Static services:Loc.Instance}}" />

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Card 1: Situs Proyek DisplayFlip (displayflip.snipgeek.com) -->
            <ui:Card Grid.Row="0" Grid.Column="0" Padding="16">
                <StackPanel>
                    <ui:SymbolIcon Symbol="Globe24" FontSize="24" HorizontalAlignment="Left" Margin="0,0,0,10" />
                    <ui:TextBlock FontTypography="BodyStrong" Text="{Binding [About.Links.Docs.Title], Source={x:Static services:Loc.Instance}}" Margin="0,0,0,4" />
                    <ui:TextBlock
                        Appearance="Secondary"
                        FontTypography="Caption"
                        Text="{Binding [About.Links.Docs.Subtitle], Source={x:Static services:Loc.Instance}}"
                        TextWrapping="Wrap"
                        Margin="0,0,0,14" />
                    <ui:Button
                        x:Name="BtnWebsite"
                        Content="{Binding [About.Links.Docs.Btn], Source={x:Static services:Loc.Instance}}"
                        Icon="{ui:SymbolIcon Symbol=Open24}"
                        HorizontalAlignment="Stretch"
                        Click="OnOpenWebsiteClick" />
                </StackPanel>
            </ui:Card>

            <!-- Card 2: Repositori GitHub -->
            <ui:Card Grid.Row="0" Grid.Column="2" Padding="16">
                <StackPanel>
                    <ui:SymbolIcon Symbol="Code24" FontSize="24" HorizontalAlignment="Left" Margin="0,0,0,10" />
                    <ui:TextBlock FontTypography="BodyStrong" Text="{Binding [About.Links.GitHub.Title], Source={x:Static services:Loc.Instance}}" Margin="0,0,0,4" />
                    <ui:TextBlock
                        Appearance="Secondary"
                        FontTypography="Caption"
                        Text="{Binding [About.Links.GitHub.Subtitle], Source={x:Static services:Loc.Instance}}"
                        TextWrapping="Wrap"
                        Margin="0,0,0,14" />
                    <ui:Button
                        x:Name="BtnDocs"
                        Content="{Binding [About.Links.GitHub.Btn], Source={x:Static services:Loc.Instance}}"
                        Icon="{ui:SymbolIcon Symbol=Open24}"
                        HorizontalAlignment="Stretch"
                        Click="OnOpenDocsClick" />
                </StackPanel>
            </ui:Card>

            <!-- Card 3: Folder Instalasi Aplikasi -->
            <ui:Card Grid.Row="2" Grid.Column="0" Padding="16">
                <StackPanel>
                    <ui:SymbolIcon Symbol="Folder24" FontSize="24" HorizontalAlignment="Left" Margin="0,0,0,10" />
                    <ui:TextBlock FontTypography="BodyStrong" Text="{Binding [About.Links.AppFolder.Title], Source={x:Static services:Loc.Instance}}" Margin="0,0,0,4" />
                    <ui:TextBlock
                        Appearance="Secondary"
                        FontTypography="Caption"
                        Text="{Binding [About.Links.AppFolder.Subtitle], Source={x:Static services:Loc.Instance}}"
                        TextWrapping="Wrap"
                        Margin="0,0,0,14" />
                    <ui:Button
                        x:Name="BtnAppFolder"
                        Content="{Binding [About.Links.AppFolder.Btn], Source={x:Static services:Loc.Instance}}"
                        Icon="{ui:SymbolIcon Symbol=FolderOpen24}"
                        HorizontalAlignment="Stretch"
                        Click="OnOpenAppFolderClick" />
                </StackPanel>
            </ui:Card>

            <!-- Card 4: File Profil Konfigurasi -->
            <ui:Card Grid.Row="2" Grid.Column="2" Padding="16">
                <StackPanel>
                    <ui:SymbolIcon Symbol="Document24" FontSize="24" HorizontalAlignment="Left" Margin="0,0,0,10" />
                    <ui:TextBlock FontTypography="BodyStrong" Text="{Binding [About.Links.ConfigFolder.Title], Source={x:Static services:Loc.Instance}}" Margin="0,0,0,4" />
                    <ui:TextBlock
                        Appearance="Secondary"
                        FontTypography="Caption"
                        Text="{Binding [About.Links.ConfigFolder.Subtitle], Source={x:Static services:Loc.Instance}}"
                        TextWrapping="Wrap"
                        Margin="0,0,0,14" />
                    <ui:Button
                        x:Name="BtnConfigFile"
                        Content="{Binding [About.Links.ConfigFolder.Btn], Source={x:Static services:Loc.Instance}}"
                        Icon="{ui:SymbolIcon Symbol=FolderOpen24}"
                        HorizontalAlignment="Stretch"
                        Click="OnOpenConfigFileClick" />
                </StackPanel>
            </ui:Card>
        </Grid>
    </StackPanel>
</Page>
