<Page
    x:Class="DisplayFlip.UI.Views.Pages.DisplaysPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="clr-namespace:DisplayFlip.UI.Services"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:DisplayFlip.UI.Controls"
    Title="{Binding [Displays.PageTitle], Source={x:Static services:Loc.Instance}}"
    d:DesignHeight="1000"
    d:DesignWidth="850"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <StackPanel Margin="32,24,32,32">
        <!-- Judul Halaman & Deskripsi -->
        <ui:TextBlock
            FontTypography="Title"
            Text="{Binding [Displays.PageTitle], Source={x:Static services:Loc.Instance}}" />
        <ui:TextBlock
            Margin="0,4,0,16"
            Appearance="Secondary"
            FontTypography="Body"
            Text="{Binding [Displays.PageSubtitle], Source={x:Static services:Loc.Instance}}" />

        <!-- Status InfoBar Notifikasi -->
        <ui:InfoBar
            x:Name="PageInfoBar"
            Margin="0,0,0,16"
            IsOpen="False"
            IsClosable="True" />

        <!-- BAGIAN 1: Kanvas Tata Letak Monitor -->
        <ui:TextBlock
            Margin="0,4,0,12"
            FontTypography="Subtitle"
            Text="{Binding [Displays.Section.Layout], Source={x:Static services:Loc.Instance}}" />

        <ui:Card Padding="16" Margin="0,0,0,16">
            <StackPanel>
                <!-- Info Header Kanvas -->
                <StackPanel Margin="0,0,0,12">
                    <ui:TextBlock FontTypography="BodyStrong" Text="{Binding [Displays.Canvas.CardTitle], Source={x:Static services:Loc.Instance}}" />
                    <ui:TextBlock
                        x:Name="CanvasSubtitleText"
                        Margin="0,2,0,0"
                        Appearance="Secondary"
                        Text="{Binding [Displays.Canvas.DefaultSubtitle], Source={x:Static services:Loc.Instance}}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <!-- Kontrol Kanvas Interaktif -->
                <controls:MonitorCanvasControl
                    x:Name="MonitorCanvas"
                    Height="260"
                    Margin="0,0,0,16" />

                <!-- Toolbar Aksi Cepat -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Kiri: Identifikasi, Snap Toggle & Nama Monitor Toggle -->
                    <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <ui:Button
                            x:Name="BtnIdentify"
                            Appearance="Secondary"
                            Content="{Binding [Displays.Toolbar.Identify], Source={x:Static services:Loc.Instance}}"
                            Click="OnIdentifyClicked"
                            Margin="0,4,16,4">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Eye24" />
                            </ui:Button.Icon>
                        </ui:Button>

                        <ui:ToggleSwitch
                            x:Name="ToggleSnap"
                            Content="{Binding [Displays.Toolbar.Snap], Source={x:Static services:Loc.Instance}}"
                            IsChecked="True"
                            Margin="0,4,16,4"
                            Checked="OnSnapToggled"
                            Unchecked="OnSnapToggled" />

                        <ui:ToggleSwitch
                            x:Name="ToggleMonitorNames"
                            Content="{Binding [Displays.Toolbar.MonitorNames], Source={x:Static services:Loc.Instance}}"
                            IsChecked="True"
                            Margin="0,4,0,4"
                            Checked="OnMonitorNamesToggled"
                            Unchecked="OnMonitorNamesToggled" />
                    </WrapPanel>

                    <!-- Kanan: Reset & Terapkan Perubahan -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button
                            x:Name="BtnReset"
                            Appearance="Secondary"
                            Content="{Binding [Displays.Toolbar.Reset], Source={x:Static services:Loc.Instance}}"
                            IsEnabled="False"
                            Click="OnResetClicked"
                            Margin="0,0,8,0">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="ArrowReset24" />
                            </ui:Button.Icon>
                        </ui:Button>

                        <ui:Button
                            x:Name="BtnApply"
                            Appearance="Primary"
                            Content="{Binding [Displays.Toolbar.Apply], Source={x:Static services:Loc.Instance}}"
                            IsEnabled="False"
                            Click="OnApplyClicked">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Checkmark24" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ui:Card>

        <!-- BAGIAN 2: Konfigurasi Monitor Terpilih -->
        <ui:TextBlock
            Margin="0,8,0,12"
            FontTypography="Subtitle"
            Text="{Binding [Displays.Section.Selected], Source={x:Static services:Loc.Instance}}" />

        <!-- Card: Identitas & Aksi Cepat Monitor Terpilih -->
        <ui:CardControl Margin="0,0,0,12">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock x:Name="SelectedMonitorTitle" FontTypography="BodyStrong" Text="{Binding [Displays.Inspector.NoSelection], Source={x:Static services:Loc.Instance}}" />
                    <ui:TextBlock x:Name="SelectedMonitorSubtitle" Appearance="Secondary" Text="{Binding [Displays.Inspector.NoSelectionSubtitle], Source={x:Static services:Loc.Instance}}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="Desktop24" />
            </ui:CardControl.Icon>
            <StackPanel Orientation="Horizontal">
                <ui:Button
                    x:Name="BtnSetPrimary"
                    Content="{Binding [Displays.Inspector.SetPrimary], Source={x:Static services:Loc.Instance}}"
                    IsEnabled="False"
                    Click="OnSetPrimaryClicked"
                    Margin="0,0,8,0">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Star24" />
                    </ui:Button.Icon>
                </ui:Button>
                <ui:Button
                    x:Name="BtnSoloDisplay"
                    Content="{Binding [Displays.Inspector.SoloDefault], Source={x:Static services:Loc.Instance}}"
                    IsEnabled="False"
                    Click="OnSoloDisplayClicked">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="FullScreenMaximize24" />
                    </ui:Button.Icon>
                </ui:Button>
            </StackPanel>
        </ui:CardControl>

        <!-- Card: Orientasi Layar -->
        <ui:CardControl Margin="0,0,0,12">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock FontTypography="BodyStrong" Text="{Binding [Displays.Inspector.Orientation.Title], Source={x:Static services:Loc.Instance}}" />
                    <ui:TextBlock Appearance="Secondary" Text="{Binding [Displays.Inspector.Orientation.Desc], Source={x:Static services:Loc.Instance}}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="ArrowRotateClockwise24" />
            </ui:CardControl.Icon>
            <ComboBox
                x:Name="OrientationComboBox"
                Width="190"
                IsEnabled="False"
                SelectionChanged="OnOrientationSelectionChanged">
                <ComboBoxItem Content="{Binding [Displays.Inspector.Orientation.Landscape], Source={x:Static services:Loc.Instance}}" Tag="Landscape" />
                <ComboBoxItem Content="{Binding [Displays.Inspector.Orientation.Portrait], Source={x:Static services:Loc.Instance}}" Tag="Portrait" />
                <ComboBoxItem Content="{Binding [Displays.Inspector.Orientation.LandscapeFlipped], Source={x:Static services:Loc.Instance}}" Tag="Rotated" />
                <ComboBoxItem Content="{Binding [Displays.Inspector.Orientation.PortraitFlipped], Source={x:Static services:Loc.Instance}}" Tag="Unhandled" />
            </ComboBox>
        </ui:CardControl>

        <!-- Card: Resolusi Layar -->
        <ui:CardControl Margin="0,0,0,16">
            <ui:CardControl.Header>
                <StackPanel>
                    <ui:TextBlock FontTypography="BodyStrong" Text="{Binding [Displays.Inspector.Resolution.Title], Source={x:Static services:Loc.Instance}}" />
                    <ui:TextBlock Appearance="Secondary" Text="{Binding [Displays.Inspector.Resolution.Desc], Source={x:Static services:Loc.Instance}}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="ScaleFill24" />
            </ui:CardControl.Icon>
            <ComboBox
                x:Name="ResolutionComboBox"
                Width="190"
                IsEnabled="False"
                SelectionChanged="OnResolutionSelectionChanged" />
        </ui:CardControl>

        <!-- BAGIAN 3: Manajemen Profil Tampilan -->
        <Grid Margin="0,8,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                FontTypography="Subtitle"
                Text="{Binding [Displays.Profiles.Title], Source={x:Static services:Loc.Instance}}" />
            <ui:Button
                x:Name="BtnSaveNewProfile"
                Grid.Column="1"
                Appearance="Primary"
                Content="{Binding [Displays.Profiles.SaveNew], Source={x:Static services:Loc.Instance}}"
                Click="OnSaveNewProfileClicked">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Add24" />
                </ui:Button.Icon>
            </ui:Button>
        </Grid>

        <!-- Kontainer Daftar Profil Tersimpan -->
        <StackPanel x:Name="ProfilesContainer" Margin="0,0,0,16">
            <ui:CardControl x:Name="EmptyProfilesCard" Margin="0,0,0,12">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock FontTypography="BodyStrong" Text="{Binding [Displays.Profiles.EmptyTitle], Source={x:Static services:Loc.Instance}}" />
                        <ui:TextBlock Appearance="Secondary" Text="{Binding [Displays.Profiles.EmptySubtitle], Source={x:Static services:Loc.Instance}}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="Save24" />
                </ui:CardControl.Icon>
            </ui:CardControl>
        </StackPanel>
    </StackPanel>
</Page>
